local function GetTree( Name: string ): Model?
	for _, TreeRegion: Model in workspace:GetChildren() do
		if TreeRegion:IsA("Model") and TreeRegion.Name == "TreeRegion" then
			for _, TreeModel: Model in TreeRegion:GetChildren() do
				local TreeClass = TreeModel:FindFirstChild("TreeClass")

				if TreeModel:IsA("Model") and TreeClass:IsA("StringValue") and TreeClass.Value == Name then
					local Owner = TreeModel:FindFirstChild("Owner")

					if Owner:IsA("ObjectValue") and not Owner.Value then
						return TreeModel
					end
				end
			end
		end
	end


	return nil
end

local function GetItem( Name: string, Owner: Player, IsBoxed: boolean ): Instance?
	for _,Item: Model in ipairs(workspace.PlayerModels:GetChildren()) do
		if not Item:IsA("Model") or not Item.PrimaryPart then continue end

		local Boxed: StringValue = Item:FindFirstChild("PurchasedBoxItemName")
		local ItemName: StringValue = Item:FindFirstChild("ItemName")
		local Owner: ObjectValue = Item:FindFirstChild("Owner")
		print(not Owner or (not ItemName and not Boxed))
		if not Owner or (not ItemName and not Boxed) then continue end

		if Owner.Value == Owner and (IsBoxed and Boxed and Boxed.Value == ModelLookup[Name]) or (ItemName and ItemName.Value == ModelLookup[Name]) then
			return Item
		end
	end

	return nil
end

