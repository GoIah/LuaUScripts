local dragCoroutine = nil

local function Drag( Item: Model )	
	if not Item then return end

	local ItemType: StringValue = Item:FindFirstChild("Type")

	if not ItemType or ItemType.Value ~= "Loose Item" then return end

	if Item and not dragCoroutine then
		dragCoroutine = task.spawn(function()
			while task.wait() do
				ClientIsDragging:FireServer(Item)
			end
		end)
	elseif dragCoroutine or not Item then
		task.cancel(dragCoroutine)
		dragCoroutine = nil
	end
end


local function MoveItem( Item: Model, ToPose: Vector3 )
	if not Item:IsA("Model") or not Item.PrimaryPart then return end
	local ItemType: StringValue = Item:FindFirstChild("Type")

	if not ItemType or not table.find(DraggableItemTypes, ItemType.Value) then return end

	Character:PivotTo(Item:GetPivot() * CFrame.new(0,2,5))
	Drag(Item)
	task.wait(1)

	Character:PivotTo(CFrame.new(ToPose + Vector3.yAxis*2))
	Item:PivotTo(CFrame.new(ToPose))
	Drag(nil)

	return true
end

local function GetAxes(): { string }
	local axeTools = {}
	
	for _,Tool: Tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
		if Tool:IsA("Tool") and Tool:FindFirstChild("CuttingTool") and Tool:FindFirstChild("ToolName") then
			table.insert(axeTools, Tool.ToolName.Value)
		end
	end
	
	for _,Tool in ipairs(Character:GetChildren()) do
		if Tool:IsA("Tool") and Tool:FindFirstChild("CuttingTool") then
			if Tool:IsA("Tool") and Tool:FindFirstChild("CuttingTool") and Tool:FindFirstChild("ToolName") then
				table.insert(axeTools, Tool.ToolName.Value)
			end
		end
	end
	
	return axeTools
end

